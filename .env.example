# SonicBook local environment overrides

# Optional FFmpeg overrides when ffmpeg/ffprobe are not in PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Google Drive OAuth configuration
# Create credentials in Google Cloud Console and copy them here.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:8000/api/google-drive/auth/callback
